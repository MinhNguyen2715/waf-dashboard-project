import re
"""
	LOG_PATTERN = re.compile(
    r'^(?P<timestamp>\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2}) \[error\].*?'
    r'\[client (?P<client_ip>[\d\.]+)\].*?'
    r'\[id "(?P<rule_id>\d+)"\].*?'
    r'Total Score: (?P<score>\d+).*?'
    r'request: "(?P<request>[^"]+)"'
)
"""

LOG_PATTERN = re.compile(
    r'^(?P<timestamp>\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2}) \[(?:error|notice|warn)\].*?'
    r'\[client (?P<client_ip>[\d\.]+)\].*?'
    r'\[id "(?P<rule_id>\d+)"\].*?'
    r'(?:Total Score: (?P<score>\d+)|(?P<score_alt>\d+))?.*?'
    r'request: "(?P<request>[^"]+)"'
)

def classify_attack(rule_id_str: str, request_str: str) -> str:
    """Categorizes attack type using exact OWASP CRS v4 configuration file ranges."""
    try:
        rule_id = int(rule_id_str)
    except (ValueError, TypeError):
        rule_id = 0

    # 1. Primary Mapping based on OWASP CRS v4 Files
    if 942000 <= rule_id <= 942999:
        return "SQL Injection (SQLi)"
    elif 941000 <= rule_id <= 941999:
        return "Cross-Site Scripting (XSS)"
    elif 930000 <= rule_id <= 930999:
        return "Path Traversal / LFI"
    elif 931000 <= rule_id <= 931999:
        return "Remote File Inclusion (RFI)"
    elif 932000 <= rule_id <= 932999:
        return "Command Injection"
    elif 933000 <= rule_id <= 933999:
        return "PHP Code Injection"
    elif 934000 <= rule_id <= 934999:
        return "Generic / Node.js Injection"
    elif 943000 <= rule_id <= 943999:
        return "Session Fixation"
    elif 944000 <= rule_id <= 944999:
        return "Java Code Injection"
    elif 913000 <= rule_id <= 913999:
        return "Scanner & Bot Probe"
    elif 911000 <= rule_id <= 911999:
        return "HTTP Method Violation"
    elif 920000 <= rule_id <= 920999:
        return "HTTP Protocol Violation"
    elif 921000 <= rule_id <= 921999:
        return "HTTP Request Smuggling"
    elif 922000 <= rule_id <= 922999:
        return "Multipart Attack"
    elif 950000 <= rule_id <= 956999:
        return "Data Leakage / Web Shell"

    # 2. Fallback: URI Signature Check (If Rule ID is 949110 / Anomaly Evaluation)
    req_lower = request_str.lower()
    if any(k in req_lower for k in [";", "|", "`", "cat%20", "wget", "curl"]):
        return "Command Injection"
    elif any(k in req_lower for k in ["script", "alert", "%3cscript%3e"]):
        return "Cross-Site Scripting (XSS)"
    elif any(k in req_lower for k in ["select", "union", "1=1", "%27"]):
        return "SQL Injection (SQLi)"
    elif any(k in req_lower for k in ["..", "etc/passwd"]):
        return "Path Traversal / LFI"

    return "Other Malicious Request"
